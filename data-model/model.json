  "measures": [
    {
      "table": "fact_production_run",
      "name": "Planned Units",
      "dax": "SUM ( 'fact_production_run'[PlannedUnits] )",
      "format": "#,0"
    },
    {
      "table": "fact_production_run",
      "name": "Actual Units",
      "dax": "SUM ( 'fact_production_run'[ActualUnits] )",
      "format": "#,0"
    },
    {
      "table": "fact_production_run",
      "name": "Scrap Units",
      "dax": "SUM ( 'fact_production_run'[ScrapUnits] )",
      "format": "#,0"
    },
    {
      "table": "fact_production_run",
      "name": "Scrap Rate %",
      "dax": "DIVIDE ( [Scrap Units], [Actual Units] + [Scrap Units] )",
      "format": "0.00%"
    },
    {
      "table": "fact_production_run",
      "name": "Production Attainment %",
      "dax": "DIVIDE ( [Actual Units], [Planned Units] )",
      "format": "0.0%"
    },
    {
      "table": "fact_production_run",
      "name": "Downtime Minutes",
      "dax": "SUM ( 'fact_production_run'[DowntimeMinutes] )",
      "format": "#,0"
    },
    {
      "table": "fact_quality_inspection",
      "name": "Inspected Units",
      "dax": "SUM ( 'fact_quality_inspection'[InspectedUnits] )",
      "format": "#,0"
    },
    {
      "table": "fact_quality_inspection",
      "name": "Defect Count",
      "dax": "SUM ( 'fact_quality_inspection'[DefectCount] )",
      "format": "#,0"
    },
    {
      "table": "fact_quality_inspection",
      "name": "Defect Rate %",
      "dax": "DIVIDE ( [Defect Count], [Inspected Units] )",
      "format": "0.00%"
    },
    {
      "table": "fact_maintenance_event",
      "name": "Maintenance Events",
      "dax": "COUNTROWS ( 'fact_maintenance_event' )",
      "format": "#,0"
    },
    {
      "table": "fact_maintenance_event",
      "name": "Preventive Maintenance %",
      "dax": "DIVIDE ( CALCULATE ( [Maintenance Events], 'fact_maintenance_event'[PreventiveFlag] = 1 ), [Maintenance Events] )",
      "format": "0.0%"
    },
    {
      "table": "fact_customer_order",
      "name": "Orders",
      "dax": "COUNTROWS ( 'fact_customer_order' )",
      "format": "#,0"
    },
    {
      "table": "fact_customer_order",
      "name": "Total Revenue",
      "dax": "SUM ( 'fact_customer_order'[Revenue] )",
      "format": "#,0"
    },
    {
      "table": "fact_customer_order",
      "name": "Late Order %",
      "dax": "DIVIDE ( SUM ( 'fact_customer_order'[LateShipmentFlag] ), [Orders] )",
      "format": "0.0%"
    }
  ]
}
